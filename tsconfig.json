{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "rootDir": "./src",
    "outDir": "./dist",

   "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",

    "types": ["node"],
    
    "sourceMap": true,
    "declaration": true,

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
     "emitDecoratorMetadata": true
    },
   "include": ["src/**/*"]
}